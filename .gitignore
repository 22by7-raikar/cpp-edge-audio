# Build trees (CMake presets build into build/<preset>)
build/
docs/api/

# Model weights and binaries (the parity corpus is a committed fixture)
*.bin
*.gguf
*.pt
*.onnx
!tests/data/*.bin

# Datasets: directory structure is tracked, contents are not
data/raw/*
!data/raw/.gitkeep
data/external/*
!data/external/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/tmp/*
!data/tmp/.gitkeep
data/manifests/chunks_*.tsv
data/labels/auto_*.tsv
data/*.wav
data/*.flac

# Local run output
results/

# Python
__pycache__/
*.pyc
.venv/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*.code-workspace
models/*
!models/.gitkeep
